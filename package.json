{
  "name": "oira666_pi-npm-token",
  "version": "0.1.3",
  "description": "Load npm publishing credentials from Pi settings for local shell commands.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gee666/pi-npm-token.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "npm",
    "token"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/ini": "^4.1.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "npm install --save-dev --ignore-scripts @earendil-works/pi-coding-agent@latest && npm run typecheck",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:integration": "node --experimental-strip-types --test test/*.integration.ts",
    "test:e2e": "node --test test/*.e2e.mjs",
    "test:evergreen": "npm test && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "ini": "^7.0.0"
  }
}
